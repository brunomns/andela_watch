# --- data/ subfolders are NOT versioned ---------------------------------------
# Sample telemetry and generated artifacts are large. Don't commit them — either
# regenerate locally (python scripts/generate_sample_data.py) or download the
# shared dataset from the Google Drive link in the README.
data/*/
data/sample_telemetry/
